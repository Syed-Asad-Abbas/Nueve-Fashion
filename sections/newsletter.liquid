<section class="section page-width">
  <div class="newsletter" {% if section.settings.image != blank %}style="--newsletter-image: url('{{ section.settings.image | image_url: width: 1600 }}')"{% endif %}>
    <div><h2>{{ section.settings.heading | escape }}</h2>{% if section.settings.text != blank %}<p>{{ section.settings.text | escape }}</p>{% endif %}</div>
    {% form 'customer', class: 'newsletter__form' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <label class="visually-hidden" for="NewsletterEmail">{{ 'newsletter.email' | t }}</label>
      <input id="NewsletterEmail" type="email" name="contact[email]" placeholder="{{ 'newsletter.email' | t }}" autocomplete="email" required>
      <button type="submit">{{ 'newsletter.submit' | t }}</button>
      {% if form.posted_successfully? %}<p class="form-message">{{ 'newsletter.success' | t }}</p>{% endif %}
      {% if form.errors %}<div class="form-message">{{ form.errors | default_errors }}</div>{% endif %}
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Stay in style" }, { "type": "textarea", "id": "text", "label": "Text" }, { "type": "image_picker", "id": "image", "label": "Background image" }],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
