<footer class="site-footer">
  <div class="page-width site-footer__inner">
    <div class="site-footer__brand">
      <a href="{{ routes.root_url }}">{% if settings.logo != blank %}{{ settings.logo | image_url: width: 480 | image_tag: alt: shop.name, loading: 'lazy' }}{% else %}{{ shop.name | escape }}{% endif %}</a>
      {% if section.settings.text != blank %}<p>{{ section.settings.text | escape }}</p>{% endif %}
    </div>
    <nav aria-label="Shop"><h2>{{ section.settings.menu_heading | escape }}</h2>{% for link in section.settings.shop_menu.links %}<a href="{{ link.url }}">{{ link.title | escape }}</a>{% endfor %}</nav>
    <nav aria-label="Customer care"><h2>{{ section.settings.care_heading | escape }}</h2>{% for link in section.settings.care_menu.links %}<a href="{{ link.url }}">{{ link.title | escape }}</a>{% endfor %}</nav>
    <div class="site-footer__social"><h2>{{ section.settings.social_heading | escape }}</h2>{% for block in section.blocks %}<a href="{{ block.settings.url }}" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</a>{% endfor %}</div>
    <small class="site-footer__copyright">© {{ 'now' | date: '%Y' }} {{ shop.name | escape }}</small>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "textarea", "id": "text", "label": "Brand description" },
    { "type": "text", "id": "menu_heading", "label": "Shop heading", "default": "Shop" },
    { "type": "link_list", "id": "shop_menu", "label": "Shop menu", "default": "main-menu" },
    { "type": "text", "id": "care_heading", "label": "Customer care heading", "default": "Customer care" },
    { "type": "link_list", "id": "care_menu", "label": "Customer care menu" },
    { "type": "text", "id": "social_heading", "label": "Social heading", "default": "Follow us" }
  ],
  "blocks": [{ "type": "social_link", "name": "Social link", "settings": [{ "type": "text", "id": "label", "label": "Label" }, { "type": "url", "id": "url", "label": "URL" }] }]
}
{% endschema %}
