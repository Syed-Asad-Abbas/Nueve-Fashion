<section class="section page-width">
  <div class="section-heading"><h2>{{ section.settings.heading | escape }}</h2>{% if section.settings.text != blank %}<p>{{ section.settings.text | escape }}</p>{% endif %}</div>
  <div class="category-grid">
    {% for block in section.blocks %}
      <a class="category-tile" href="{{ block.settings.link | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
        {% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400, 600, 800, 1000', alt: block.settings.image.alt }}{% else %}{{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}{% endif %}
        <span class="category-tile__text"><strong>{{ block.settings.heading | escape }}</strong><span>{{ block.settings.caption | escape }}</span></span><span class="category-tile__arrow" aria-hidden="true">↗</span>
      </a>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Category grid",
  "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Curated for you" }, { "type": "textarea", "id": "text", "label": "Text" }],
  "blocks": [{ "type": "category", "name": "Category", "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Collection" }, { "type": "text", "id": "caption", "label": "Caption", "default": "Explore" }, { "type": "image_picker", "id": "image", "label": "Image" }, { "type": "url", "id": "link", "label": "Link" }] }],
  "presets": [{ "name": "Category grid", "blocks": [{ "type": "category" }, { "type": "category" }, { "type": "category" }, { "type": "category" }] }]
}
{% endschema %}
