<section class="section page-width">
  <div class="section-heading"><h2>{{ section.settings.heading | escape }}</h2></div>
  {% if section.settings.collection != blank %}
    <div class="product-grid">{% for product in section.settings.collection.products limit: section.settings.limit %}{% render 'product-card', product: product %}{% endfor %}</div>
    <div class="section__footer"><a class="button button--dark" href="{{ section.settings.collection.url }}">{{ 'general.view_more' | t }} ↗</a></div>
  {% else %}
    <p class="empty-state">{{ 'general.empty' | t }}</p>
  {% endif %}
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Trending now" }, { "type": "collection", "id": "collection", "label": "Collection" }, { "type": "range", "id": "limit", "label": "Products to show", "min": 3, "max": 12, "step": 1, "default": 6 }],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
